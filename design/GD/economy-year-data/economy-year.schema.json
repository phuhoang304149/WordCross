{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "wordcross/economy-year/1.0.0",
 "title": "WordCross economy-year bundle (coin, shop, ads, quests, 365-day cycle)",
 "description": "Dữ liệu trung lập, chưa có importer Unity. Mỗi file JSON có schemaVersion + kind; $defs.* mô tả từng kind. validate.py kiểm tập con (type/required/enum/min/pattern/items/properties).",
 "$defs": {
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
  "coinInt": {"type": "integer", "minimum": 0},
  "quest": {"type": "object", "required": ["id", "scope", "metric", "target", "coin", "locKey", "requiresPurchase", "requiresAd"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "scope": {"enum": ["daily", "weekly", "monthly", "event"]},
    "metric": {"enum": ["levels_won", "words_found", "daily_challenge_done", "bot_match_played", "bot_match_won", "extra_word_found", "login_days"]},
    "target": {"type": "integer", "minimum": 1}, "coin": {"$ref": "#/$defs/coinInt"}, "locKey": {"type": "string"}, "eventId": {"type": "string"},
    "requiresPurchase": {"enum": [false]}, "requiresAd": {"enum": [false]}}},
  "quests": {"type": "object", "required": ["schemaVersion", "kind", "templates", "dailyAllClearCoin"],
   "properties": {"schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}, "kind": {"enum": ["quests"]}, "templates": {"type": "array", "items": {"$ref": "#/$defs/quest"}}, "dailyAllClearCoin": {"$ref": "#/$defs/coinInt"}}},
  "day": {"type": "object", "required": ["day", "month", "week", "dow", "loginRef", "dailyQuestRefs", "eventRef", "bridge"],
   "properties": {"day": {"type": "integer", "minimum": 1}, "month": {"type": "integer", "minimum": 1}, "dow": {"type": "integer", "minimum": 1}, "loginRef": {"type": "string"}, "dailyQuestRefs": {"type": "array", "items": {"type": "string"}}, "bridge": {"type": "boolean"}}},
  "calendar": {"type": "object", "required": ["schemaVersion", "kind", "cycle", "loginRewards", "days", "weeks", "months", "events"],
   "properties": {"schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}, "kind": {"enum": ["calendar"]},
    "cycle": {"type": "object", "required": ["lengthDays", "anchorUtcDate", "idFormat", "bridgeDay"], "properties": {"lengthDays": {"type": "integer", "minimum": 365}, "anchorUtcDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}},
    "loginRewards": {"type": "array", "items": {"type": "object", "required": ["id", "coin", "locKey"]}},
    "days": {"type": "array", "items": {"$ref": "#/$defs/day"}},
    "weeks": {"type": "array", "items": {"type": "object", "required": ["week", "startDay", "endDay", "questRefs", "allClearCoin"]}},
    "months": {"type": "array", "items": {"type": "object", "required": ["month", "startDay", "endDay", "lengthDays", "questRefs", "allClearCoin", "locKey"]}},
    "events": {"type": "array", "items": {"type": "object", "required": ["id", "startDay", "endDay", "locKey", "questRefs", "completionCoin", "optional"]}}}},
  "config": {"type": "object", "required": ["schemaVersion", "kind", "status", "currency", "earn", "sinks", "shop", "ads", "streak", "levelMilestones", "totals", "baseline", "rules"],
   "properties": {"schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}, "kind": {"enum": ["economy"]}, "status": {"enum": ["PROPOSAL_TUNING_NOT_APPROVED"]},
    "currency": {"type": "object", "required": ["id", "startBalance", "secondCurrency"], "properties": {"id": {"enum": ["coin"]}, "startBalance": {"$ref": "#/$defs/coinInt"}, "secondCurrency": {"enum": [null]}}},
    "sinks": {"type": "array", "items": {"type": "object", "required": ["id", "coin", "locKey"], "properties": {"coin": {"type": "integer", "minimum": 1}}}},
    "shop": {"type": "object", "required": ["packs", "paymentSimulatedInDesign"], "properties": {"packs": {"type": "array", "items": {"type": "object", "required": ["id", "productId", "coin", "priceTier", "proposedUsd", "removesAds", "locKey"]}}}},
    "ads": {"type": "object", "required": ["rewarded", "interstitial", "states", "rules", "maxRewardedCoinPerDay"]}}},
  "loc": {"type": "object", "required": ["schemaVersion", "kind", "languages", "keys"], "properties": {"kind": {"enum": ["loc"]}, "keys": {"type": "object"}}}
 },
 "files": {"economy-config.json": "#/$defs/config", "quest-templates.json": "#/$defs/quests", "calendar-365.json": "#/$defs/calendar", "loc-keys.json": "#/$defs/loc"}
}
